STUDYOS_ENV=development
STUDYOS_DATABASE_URL=postgresql+psycopg://studyos:studyos@localhost:5432/studyos
STUDYOS_DATA_DIR=./.studyos/uploads
STUDYOS_MAX_UPLOAD_MB=50
STUDYOS_LOG_LEVEL=INFO
# Trust only your reverse proxy addresses in production.
STUDYOS_FORWARDED_ALLOW_IPS=127.0.0.1

# Optional error tracking
# STUDYOS_SENTRY_DSN=
STUDYOS_SENTRY_TRACES_SAMPLE_RATE=0
STUDYOS_RELEASE=0.55.0

# Optional closed-app Web Push. Generate a VAPID key pair for production.
# STUDYOS_VAPID_PUBLIC_KEY=
# STUDYOS_VAPID_PRIVATE_KEY=
STUDYOS_VAPID_SUBJECT=mailto:admin@example.com
STUDYOS_PUSH_POLL_SECONDS=300
STUDYOS_AUTH_RATE_LIMIT_ATTEMPTS=10
STUDYOS_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Verified cloud accounts + password recovery by 6-digit email code
STUDYOS_REQUIRE_EMAIL_VERIFICATION=true
STUDYOS_EMAIL_VERIFICATION_CODE_MINUTES=15
STUDYOS_EMAIL_VERIFICATION_MAX_ATTEMPTS=5
STUDYOS_PASSWORD_RESET_CODE_MINUTES=10
STUDYOS_PASSWORD_RESET_MAX_ATTEMPTS=5
# Preferred on hosted environments such as Railway Hobby: Brevo HTTPS API
# STUDYOS_BREVO_API_KEY=
# SMTP remains available as a fallback for local/self-hosted deployments.
# STUDYOS_SMTP_HOST=smtp.example.com
STUDYOS_SMTP_PORT=587
# STUDYOS_SMTP_USERNAME=
# STUDYOS_SMTP_PASSWORD=
# STUDYOS_SMTP_FROM_EMAIL=no-reply@example.com
STUDYOS_SMTP_USE_TLS=true

# Optional Spotify study soundtrack integration.
# Create a Spotify Web API app and allow the redirect URI below.
# Use a long random integration secret; it encrypts OAuth tokens at rest.
# STUDYOS_INTEGRATION_SECRET=
# STUDYOS_SPOTIFY_CLIENT_ID=
# STUDYOS_SPOTIFY_CLIENT_SECRET=
STUDYOS_SPOTIFY_REDIRECT_URI=https://studyos.courses/api/v1/integrations/spotify/callback

STUDYOS_TUTOR_PROVIDER=local
STUDYOS_TUTOR_EMBEDDING_PROVIDER=none
# OPENAI_API_KEY=
STUDYOS_OPENAI_TUTOR_MODEL=gpt-5.6-luna
STUDYOS_OPENAI_TUTOR_MAX_OUTPUT_TOKENS=900
STUDYOS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Docker Compose
POSTGRES_PASSWORD=replace-with-a-long-random-password
STUDYOS_WEB_PORT=3000

# Comma-separated accounts granted StudyOS admin/catalog access.
# Admin status is reconciled from this list whenever an account logs in.
STUDYOS_ADMIN_EMAILS=admin@example.com
