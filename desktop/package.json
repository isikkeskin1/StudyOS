{
  "name": "studyos-desktop",
  "version": "0.53.0",
  "private": true,
  "description": "StudyOS desktop client",
  "main": "main.cjs",
  "author": "StudyOS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "pack:win": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.studyos.desktop",
    "productName": "StudyOS",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "setup.html",
      "package.json",
      "update.html",
      "splash.html"
    ],
    "extraResources": [
      {
        "from": "build/web/server.js",
        "to": "web/server.js"
      },
      {
        "from": "build/web/.next",
        "to": "web/.next",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/web/public",
        "to": "web/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/web/node_modules",
        "to": "web/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/web/package.json",
        "to": "web/package.json"
      },
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../web/public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StudyOS",
      "artifactName": "StudyOS-${version}-Windows-x64-Setup.${ext}"
    },
    "portable": {
      "artifactName": "StudyOS-${version}-Windows-x64-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "isikkeskin1",
        "repo": "StudyOS",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
